# processes, building the library and executable in %%check.
%global _smp_tasksize_proc 8192

%if 0%{?__isa_bits} == 32
# Reduce memory demands by lowering the debuginfo level.
%global rustflags_debuginfo 1
%endif

%prep
%autosetup -n %{crate}-%{version} -p1
# Copy in test crates, required to run tests, but not included in the released
# crate. We do this before %%generate_buildrequires because we need to generate
# their dependencies, then remove them in %%build to prove that the binary RPMs
# are derived solely from the published crate sources, and finally restore them
# in %%check where they are needed for testing.
tar -xzvf '%{SOURCE10}' --strip-components=1 \
    cargo-semver-checks-%{version}/test_crates
%cargo_prep

%generate_buildrequires
%cargo_generate_buildrequires
%if %{with check}
for cargo_toml in test_crates/*/*/Cargo.toml
do
    pushd "$(dirname "${cargo_toml}")" >/dev/null
    %cargo_generate_buildrequires -a
    popd >/dev/null
done
%endif

