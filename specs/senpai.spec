# Generated by go2rpm 1.19.0
%bcond check 1

# https://github.com/delthas/senpai
# -- Mirror of https://sr.ht/~delthas/senpai
# go2rpm can't automatically process sr.ht yet
%global goipath         github.com/delthas/senpai
Version:                0.5.0

%gometa -L -f


Name:           senpai
Release:        %autorelease
Summary:        Your everyday IRC student

# Generated by go-vendor-tools
License:        Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND ISC AND MIT
URL:            %{gourl}
Source0:        %{gosource}
# Generated by go-vendor-tools
Source1:        %{archivename}-vendor.tar.bz2
Source2:        go-vendor-tools.toml

BuildRequires:  go-vendor-tools

%description
senpai is an IRC client that works best with bouncers:

- no logs are kept,
- history is fetched from the server via chathistory,
- networks are fetched from the server via bouncer-networks,
- messages can be searched in logs via search,
- files can be uploaded via filehost (with drag & drop!)

%prep
%goprep -p1
tar -xf %{S:1}

%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:2}

%build
%global gomodulesmode GO111MODULE=on
# goipath is the GitHub mirror (see above), but go.mod declares
# git.sr.ht/~delthas/senpai -- build by relative path, not %%{goipath}/$cmd
for cmd in cmd/* ; do
  %gobuild -o %{gobuilddir}/bin/$(basename $cmd) ./$cmd
done

%install
%go_vendor_license_install -c %{S:2}
install -m 0755 -vd                     %{buildroot}%{_bindir}
install -m 0755 -vp %{gobuilddir}/bin/* %{buildroot}%{_bindir}/

%check
%go_vendor_license_check -c %{S:2}
%if %{with check}
%gotest ./...
%endif

%files -f %{go_vendor_license_filelist}
%doc doc README.md
%{_bindir}/senpai


%changelog
%autochangelog
