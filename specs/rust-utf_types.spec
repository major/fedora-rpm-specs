# Generated by rust2rpm 28
%bcond check 1
%global debug_package %{nil}

# The COPYRIGHT file says,
#
#   Test code is dedicated to the Public Domain when so designated (see
#   the individual files for PD/CC0-dedicated sections).
#
# This is a bit ambiguous: a public-domain dedication is allowed for code in
# Fedora, but upstream conflates this with the CC0-1.0 license, which is not
# allowed. We must err on the side of removing any possibly-CC0-1.0 test code
# before uploading the crate archive.
#
# We raised the issue upstream in “Consider not using CC0-1.0 for test code,”
# https://github.com/hsivonen/utf_types/issues/1.

%global crate utf_types

Name:           rust-utf_types
Version:        1.0.0
Release:        %autorelease
Summary:        Types for UTF-8 and UTF-16 code units and code unit sequences

License:        Apache-2.0 OR MIT
URL:            https://crates.io/crates/utf_types
Source:         %{crate}-%{version}-clean.crate
# * script to create tarball with possibly-CC0-1.0-licensed tests removed:
# * run "rust2rpm" and then "./get_source" for new versions
Source10:       get_source

BuildRequires:  cargo-rpm-macros >= 24

%global _description %{expand:
Types for UTF-8 and UTF-16 code units and code unit sequences.}

%description %{_description}

%package        devel
Summary:        %{summary}
BuildArch:      noarch

%description    devel %{_description}

This package contains library source intended for building other packages which
use the "%{crate}" crate.

%files          devel
%license %{crate_instdir}/COPYRIGHT
%license %{crate_instdir}/LICENSE-APACHE
%license %{crate_instdir}/LICENSE-MIT
%doc %{crate_instdir}/CONTRIBUTING.md
%doc %{crate_instdir}/README.md
%{crate_instdir}/

%package     -n %{name}+default-devel
Summary:        %{summary}
BuildArch:      noarch

%description -n %{name}+default-devel %{_description}

This package contains library source intended for building other packages which
use the "default" feature of the "%{crate}" crate.

%files       -n %{name}+default-devel
%ghost %{crate_instdir}/Cargo.toml

%prep
%autosetup -n %{crate}-%{version} -p1
if grep -ErinI 'cc0|creative.commons' \
    --exclude=COPYRIGHT --exclude=CONTRIBUTING.md . >/dev/null
then
   cat 1>&2 <<'EOF'
Possible CC0-1.0-licensed test code detected; make sure we are using the
“clean” crate source!
EOF
  exit 1
fi
%cargo_prep

%generate_buildrequires
%cargo_generate_buildrequires

%build
%cargo_build

%install
%cargo_install

%if %{with check}
%check
%cargo_test
%endif

%changelog
%autochangelog
