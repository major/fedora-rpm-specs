%prep
%autosetup -p1 -n %{srcname}-%{version}

# Remove the cythonized files in order to regenerate them during build.
rm $(grep -rl '/\* Generated by Cython')
# Do not ship tests
sed -i -e '/"cytoolz.tests"/d' pyproject.toml
sed -i -e '\,/tests/,d' MANIFEST.in
sed -i -e "s|, 'tests/\*.py'||" setup.py


%generate_buildrequires
%pyproject_buildrequires


%build
%pyproject_wheel


%install
%pyproject_install
%pyproject_save_files -l %{srcname}
sed -i '\#cytoolz/tests#d' %{pyproject_files}
# Ensure tests are not shipped
rm -rf %{buildroot}%{python3_sitearch}/%{srcname}/tests


%check
# Must run with built directory https://github.com/pytoolz/cytoolz/issues/235
%pytest -v build/lib.%{python3_platform}-cpython-%{python3_version_nodots}/cytoolz


%files -n python%{python3_pkgversion}-%{srcname} -f %{pyproject_files}


%changelog
%autochangelog
