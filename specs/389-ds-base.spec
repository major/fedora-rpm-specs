%endif

%if %{defined SOURCE8}
# Unpack prebuilt cockpit files
tar xvjf %{SOURCE8} -C src/cockpit/389-console
%endif

cp %{SOURCE2} README.devel

%build
%if %{with clang}
CLANG_FLAGS="--enable-clang"
%endif

%if %{with asan}
ASAN_FLAGS="--enable-asan --enable-debug"
%endif

%if %{with msan}
MSAN_FLAGS="--enable-msan --enable-debug"
%endif

%if %{with tsan}
