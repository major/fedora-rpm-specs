%bcond check 0
%global debug_package %{nil}

%global crate ssh2

Name:           rust-ssh2
Version:        0.9.6
Release:        %autorelease
Summary:        Bindings to libssh2 for interacting with SSH servers
License:        MIT OR Apache-2.0
URL:            https://crates.io/crates/ssh2
